VITE_ENTER_ANALYTICS_ENABLED=true
VITE_ENTER_ANALYTICS_TOKEN=
VITE_ENTER_PROJECT_ID=
VITE_ENTER_ANALYTICS_ENDPOINT=https://api.enter.pro
VITE_ENTER_ANALYTICS_DEFINITIONS_ENDPOINT=
VITE_ENTER_ANALYTICS_DEBUG=false

# Convex (real-time sync + AI recommendations)
# Set this to your Convex deployment URL — required, app will not start without it
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Python AI backend (optional — leave empty to use Supabase edge function instead)
VITE_PYTHON_BACKEND_URL=

# Gemini API key for client-side incident analysis only
# Budget-review AI uses GEMINI_API_KEY set as a Supabase Edge Function secret (server-side)
VITE_GEMINI_API_KEY=

# Backend secrets (set in Supabase/Enter Cloud edge function secrets, NOT in frontend)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# FINANCE_NOTION_TOKEN=
# NOTION_REQUESTS_DB_ID=
# NOTION_POLICIES_DB_ID=
# GITHUB_TOKEN=
# GITHUB_REPO=
