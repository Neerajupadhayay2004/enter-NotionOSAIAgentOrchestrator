-- Security incidents: the durable record of a detected threat and its lifecycle
create table public.security_incidents (
  id uuid primary key default gen_random_uuid(),
  incident_number text not null unique,
  title text not null,
  category text not null check (category in ('port_scan','brute_force','malware','ddos','phishing','c2_beacon')),
  source_ip text not null,
  file_hash text,
  severity text not null default 'low' check (severity in ('low','medium','high','critical')),
  risk_score numeric not null default 0,
  status text not null default 'detected' check (status in ('detected','analyzing','pending_approval','resolved','dismissed')),
  decision text check (decision in ('monitor','block','none')),
  notion_page_id text,
  notion_url text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

-- Normalized OSINT evidence, one row per source per incident ("evidence card" backing store)
create table public.incident_evidence (
  id uuid primary key default gen_random_uuid(),
  incident_id uuid not null references public.security_incidents(id) on delete cascade,
  source text not null check (source in ('shodan','abuseipdb','virustotal','alienvault_otx')),
  verdict text not null default 'unknown' check (verdict in ('clean','suspicious','malicious','unknown')),
  score numeric not null default 0,
  summary text not null default '',
  raw_response jsonb,
  created_at timestamptz not null default now()
);

-- Immutable audit trail: every agent/human action, fully traceable and searchable
create table public.incident_actions (
  id uuid primary key default gen_random_uuid(),
  incident_id uuid not null references public.security_incidents(id) on delete cascade,
  actor text not null check (actor in ('threat_detection','malware_analysis','incident_response','compliance','human','system')),
  action_type text not null check (action_type in ('detect','enrich','analyze','decide','escalate','human_decision','block_executed','notion_synced','error')),
  reasoning text,
  payload jsonb,
  search_text text,
  created_at timestamptz not null default now()
);

-- Live agent status, powers the "AI Agents Status" dashboard panel
create table public.agent_status (
  agent_name text primary key check (agent_name in ('threat_detection','malware_analysis','incident_response','compliance')),
  state text not null default 'idle' check (state in ('idle','working','blocked')),
  last_active_at timestamptz not null default now(),
  current_incident_id uuid references public.security_incidents(id) on delete set null
);

insert into public.agent_status (agent_name, state) values
  ('threat_detection', 'idle'),
  ('malware_analysis', 'idle'),
  ('incident_response', 'idle'),
  ('compliance', 'idle');

create index idx_incident_evidence_incident_id on public.incident_evidence(incident_id);
create index idx_incident_actions_incident_id on public.incident_actions(incident_id);
create index idx_security_incidents_status on public.security_incidents(status);
create index idx_incident_actions_search on public.incident_actions using gin (to_tsvector('english', coalesce(search_text, '')));

alter table public.security_incidents enable row level security;
alter table public.incident_evidence enable row level security;
alter table public.incident_actions enable row level security;
alter table public.agent_status enable row level security;

create policy "Public can view security incidents" on public.security_incidents for select using (true);
create policy "Public can view incident evidence" on public.incident_evidence for select using (true);
create policy "Public can view incident actions" on public.incident_actions for select using (true);
create policy "Public can view agent status" on public.agent_status for select using (true);

create trigger trg_security_incidents_updated_at
before update on public.security_incidents
for each row execute function public.set_updated_at();

alter publication supabase_realtime add table public.security_incidents;
alter publication supabase_realtime add table public.incident_evidence;
alter publication supabase_realtime add table public.incident_actions;
alter publication supabase_realtime add table public.agent_status;
