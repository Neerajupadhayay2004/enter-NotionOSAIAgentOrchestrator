-- Budget requests: the durable record of a Marketing <-> Finance negotiation
create table public.budget_requests (
  id uuid primary key default gen_random_uuid(),
  campaign_name text not null,
  category text not null,
  requested_amount numeric not null,
  final_amount numeric,
  justification text not null default '',
  requested_by text not null default 'Marketing Team',
  status text not null default 'negotiating' check (status in ('negotiating','pending_approval','approved','rejected','completed')),
  notion_page_id text,
  notion_url text,
  github_issue_url text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

-- Immutable audit log: every agent/human action, fully traceable
create table public.agent_actions (
  id uuid primary key default gen_random_uuid(),
  request_id uuid not null references public.budget_requests(id) on delete cascade,
  actor text not null check (actor in ('marketing','finance','human','system')),
  action_type text not null check (action_type in ('propose','review','counter','accept','escalate','human_decision','notion_synced','github_issue_created')),
  amount numeric,
  reasoning text,
  payload jsonb,
  created_at timestamptz not null default now()
);

create index idx_agent_actions_request_id on public.agent_actions(request_id);
create index idx_budget_requests_status on public.budget_requests(status);

alter table public.budget_requests enable row level security;
alter table public.agent_actions enable row level security;

-- Read-only for the public dashboard; all writes go through edge functions (service role)
create policy "Public can view budget requests" on public.budget_requests for select using (true);
create policy "Public can view agent actions" on public.agent_actions for select using (true);

create or replace function public.set_updated_at()
returns trigger as $$
begin
  new.updated_at = now();
  return new;
end;
$$ language plpgsql set search_path = public;

create trigger trg_budget_requests_updated_at
before update on public.budget_requests
for each row execute function public.set_updated_at();

alter publication supabase_realtime add table public.budget_requests;
alter publication supabase_realtime add table public.agent_actions;
